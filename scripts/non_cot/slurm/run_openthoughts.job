#!/bin/bash
#SBATCH --job-name=openthoughts_non_cot
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:l40s
#SBATCH --mem=64G
#SBATCH --time=2-00:00:00
#SBATCH --output=slurm_logs/%x-%j.out
#SBATCH --error=slurm_logs/%x-%j.err

source /project2/kpsounis_171/ryanswif/rapid/scripts/common.slurm
which python
which rapid
bash scripts/non_cot/run_openthoughts_qwen.sh
bash scripts/non_cot/run_openthoughts_gemma3.sh
