#!/bin/bash
#SBATCH --job-name=smoltalk_cot
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gres=gpu:l40s
#SBATCH --mem=64G
#SBATCH --time=2-00:00:00
#SBATCH --output=slurm_logs/%x-%j.out
#SBATCH --error=slurm_logs/%x-%j.err

source /project2/kpsounis_171/ryanswif/rapid/scripts/common.slurm
which python
which rapid
bash scripts/cot/run_smoltalk_qwen_cot.sh
bash scripts/cot/run_smoltalk_gemma3_cot.sh
